  <property name="styleSheet">
   <string notr="true">/* === Overall Dialog === */
QDialog {
    background-color: #CDDECB; /* Light Gray */
    color: #122B1D; /* Dark Jungle Green */
    font-family: Segoe UI, sans-serif;
}
QComboBox QAbstractItemView {
    background-color: white;
    color: #122B1D;
    selection-background-color: #9CC97F;
    selection-color: #122B1D;
    border: 1px solid #90B7BF;
}

/* === Main Section Labels === */
QLabel {
    color: #122B1D;
    font-size: 9pt;
    font-weight: 600;
}

/* === Logo / App Title === */
#labelMain {
    font-size: 14pt;
    font-weight: bold;
    color: #537E72; /* William Hooker's Green */
    qproperty-alignment: AlignCenter;
}

/* === Secondary / Helper Labels === */
#labelTime1, #labelTime2,
#labelCategory_6,#labelNClusters, #labelCategory_7 {
    font-size: 8pt;
    color: #122B1D;
    font-weight: normal;
}

#labelBasicOptions, #labelClusterOptions,
#labelIsoOptions {
    font-size: 8pt;
    color: #122B1D;
    font-weight: bold;
}


/* === ComboBoxes === */
QComboBox {
    background-color: white;
    border: 1px solid #90B7BF; /* Pewter Blue */
    border-radius: 4px;
    padding: 4px;
}

QComboBox:hover {
    border: 1px solid #537E72;
}

/* === SpinBoxes === */
QSpinBox {
    background-color: white;
    border: 1px solid #90B7BF;
    border-radius: 4px;
    padding: 2px;
}

/* === Buttons === */
QPushButton {
    background-color: #537E72;
    color: white;
    font-weight: bold;
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #9CC97F;
    color: #122B1D;
}

/* === Frames (Grouping Panels) === */
QFrame {
    border: 1px solid #90B7BF;
    border-radius: 4px;
    background-color: #EAEFE8;
    padding: 6px;
}
</string>
